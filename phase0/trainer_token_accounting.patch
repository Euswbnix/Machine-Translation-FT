+                    "cell\tseed\ttokens\tdev_ce\tdev_ce_ntok\tdev_bleu\t"
+                    "optimizer_steps\tglobal_step\n")
+        cell = self.ckpt_dir.name
+        seed = self.config["training"].get("seed", 0)
+        self.dev_ce_trace.write(
+            f"{cell}\t{seed}\t{self.applied_target_tokens}\t{ce:.6f}\t{ntok}\t"
+            f"{'' if bleu is None else f'{bleu:.4f}'}\t{self.optimizer_steps}\t"
+            f"{self.global_step}\n")
+        self.dev_ce_trace.flush()
 

+    def _should_continue(self) -> bool:
+        """Primary training gate.
+
+        max_steps counts micro-batches. Two arms with different accumulate_steps
+        are therefore NOT comparable under it: at accumulate_steps 12 vs 17, equal
+        max_steps gives the first arm 17/12 = 1.42x more applied tokens. So when
+        max_target_tokens is set, max_steps is not consulted at all; only an
+        explicitly configured micro-step backstop can pre-empt the token budget,
+        and when it does it says so.
+        """
+        if self.max_target_tokens:
+            if self.applied_target_tokens >= self.max_target_tokens:
+                return False
+            if (self.max_micro_steps_backstop
+                    and self.global_step >= self.max_micro_steps_backstop):
+                if not self._stopped_on_backstop:
+                    print(f"  STOPPED ON STEP BACKSTOP at {self.global_step:,} "
+                          f"micro-steps with only {self.applied_target_tokens:,} of "
+                          f"{self.max_target_tokens:,} target tokens applied "
+                          f"({self.applied_target_tokens/self.max_target_tokens*100:.1f}%). "
+                          "The token budget was NOT reached.")
+                self._stopped_on_backstop = True
+                return False
+            return True
+        return self.global_step < self.max_steps
+
+    def _eval_due(self) -> bool:
+        """Token-keyed eval cadence when configured, else the step-keyed one.
+
+        The step-keyed path runs through _update_eval_interval, which derives the
+        interval from an EMA of TRAINING LOSS -- i.e. from model capacity. Any
+        experiment comparing capacities must use the token-keyed path, or the eval
+        grid becomes a function of the variable under study.
+        """
+        if self.eval_every_tokens:
+            return self.applied_target_tokens >= self._next_eval_tokens
+        return self.global_step >= self._next_eval_step and self.global_step > 0
+
+    @torch.no_grad()
+    def _evaluate_ce(self):
+        """Held-out cross-entropy in NATS per non-pad target token.
+
+        Deliberately not the training criterion:
+          - label smoothing OFF (it adds a constant that depends on vocabulary
+            support, so smoothed losses are not comparable as a convergence signal)
+          - fp32 (bf16 accumulation over a whole dev set loses precision the
+            post-hoc argmin depends on)
+          - teacher-forced (no beam, no search noise, monotone in fit)
+        Beam BLEU is retained for reporting but is NOT a convergence signal: it is
+        noisy and non-monotone, and an argmax over it is upward-biased by an amount
+        that grows with the number of evaluations, which differs across arms.
+
+        Returns (nats_per_token, n_tokens).
+        """
+        was_training = self.model.training
+        self.model.eval()
+        ce = nn.CrossEntropyLoss(ignore_index=PAD_ID, reduction="sum",
+                                 label_smoothing=0.0)
+        total, ntok = 0.0, 0
+        for batch in self.valid_loader:
+            src = batch["src"].to(self.device)
+            tgt = batch["tgt"].to(self.device)
+            logits = self.model(src, tgt[:, :-1])          # fp32: no autocast here
+            labels = tgt[:, 1:]
+            total += ce(logits.float().reshape(-1, logits.size(-1)),
+                        labels.contiguous().view(-1)).item()
+            ntok += int((labels != PAD_ID).sum().item())
+        if was_training:
+            self.model.train()
+        return (total / ntok if ntok else float("nan")), ntok
+
+    def _log_dev_ce(self, ce: float, ntok: int, bleu):
